<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- Define index.php como documento padrão -->
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>
        
        <!-- Desabilita listagem de diretórios -->
        <directoryBrowse enabled="false" />
        
        <!-- Configuração de erro detalhada para debug (remover em produção final) -->
        <httpErrors errorMode="Detailed" />
    </system.webServer>
</configuration>
