# Define index.php como documento padrão
DirectoryIndex index.php

# Redireciona tudo para index.php quando não for arquivo/diretório
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Evita loop: se já está em public/, não faz nada
    RewriteCond %{REQUEST_URI} ^/sistema/public/
    RewriteRule ^ - [L]
    
    # Se a requisição é para assets/ e não existe na raiz, redireciona para public/assets/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]
    
    # Se é um arquivo ou diretório que existe na raiz, serve ele diretamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # Caso contrário, redireciona para index.php
    RewriteRule . index.php [L]
</IfModule>