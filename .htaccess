# Define index.php como documento padrão
DirectoryIndex index.php

# Redireciona tudo para index.php quando não for arquivo/diretório
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Se a requisição é para assets/, redireciona para public/assets/
    RewriteCond %{REQUEST_URI} ^/sistema/assets/(.*)$
    RewriteRule ^.*$ public/assets/%1 [L]
    
    # Se é um arquivo ou diretório que existe na raiz, serve ele diretamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # Caso contrário, redireciona para index.php
    RewriteRule . index.php [L]
</IfModule>